# GHCR image namespace, without the ghcr.io/ prefix.
PHISHSHIELD_IMAGE_NAMESPACE=josenieto

# Use an explicit published version. Release candidates do not use latest.
PHISHSHIELD_IMAGE_TAG=v0.1.0-rc.2

# Host port for the frontend.
PHISHSHIELD_FRONTEND_PORT=8080

# Maximum accepted .eml upload size in bytes.
PHISHSHIELD_MAX_UPLOAD_BYTES=1000000
