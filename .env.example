# Maximum accepted .eml upload size in bytes.
# Must be a positive integer.
PHISHSHIELD_MAX_UPLOAD_BYTES=1000000

# Optional local advisory model. Keep disabled by default.
PHISHSHIELD_MODEL_ASSESSMENT_ENABLED=false
# Set these only when running an experimental local model artifact.
PHISHSHIELD_MODEL_ARTIFACT_PATH=
PHISHSHIELD_MODEL_METADATA_PATH=
